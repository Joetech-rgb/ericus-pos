{% extends "base.html" %}
{% block title %}Audit Log - Ericus POS{% endblock %}
{% block page_title %}Audit Log{% endblock %}
{% block nav_audit %}active{% endblock %}

{% block extra_head %}
<style>
  .level-badge {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border-radius: 50px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.3px;
    text-transform: uppercase;
  }
  .level-info     { background: #e8f4fd; color: #0b5ed7; }
  .level-warning  { background: #fff3cd; color: #664d03; }
  .level-critical { background: #f8d7da; color: #b02a37; }

  .quick-btn {
    padding: 6px 14px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--card-bg, #fff);
    color: var(--text2, #555);
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .quick-btn:hover, .quick-btn.active {
    background: #4a6cf7;
    color: #fff;
    border-color: #4a6cf7;
    box-shadow: 0 2px 4px rgba(74, 108, 247, 0.15);
  }
  
  .filter-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
    align-items: end;
  }
  
  .audit-table th {
    padding: 12px 14px;
    text-align: left;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--text3, #6c757d);
    font-weight: 600;
    background: rgba(0,0,0,0.01);
  }
  .audit-table td {
    padding: 12px 14px;
    vertical-align: top;
  }
  .audit-table tr {
    border-bottom: 1px solid var(--border);
    transition: background 0.15s ease;
  }
  .audit-table tr:hover {
    background: rgba(0,0,0,0.005);
  }
</style>
{% endblock %}

{% block content %}
<div class="page-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid var(--border);">
  <h1 style="margin:0; font-size: 24px; font-weight: 700; color: var(--text);">Audit Trail</h1>
  <div style="display:flex; gap:8px;">
    <a href="{% url 'audit:export_csv' %}?{{ request.GET.urlencode }}" class="btn btn-outline" style="display: inline-flex; align-items: center; gap: 6px;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
      Export CSV
    </a>
    {% if request.user.is_owner %}
    <form method="post" action="{% url 'audit:clear' %}" style="display:inline;"
          onsubmit="return confirm('Delete all logs older than 90 days?');">
      {% csrf_token %}
      <button type="submit" class="btn btn-outline" style="color:#dc3545; border-color:#f5c6cb; display: inline-flex; align-items: center; gap: 6px;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></button>
    </form>
    {% endif %}
  </div>
</div>

<div class="analytics-summary-deck" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 24px;">
  <div class="metric-card" style="background: var(--card-bg, #fff); border: 1px solid var(--border); border-radius: 8px; padding: 16px;">
    <span class="metric-label" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text3, #6c757d);">Events Today</span>
    <span class="metric-value" style="font-size: 24px; font-weight: 700; color: var(--text); display: block; margin-top: 4px;">{{ total_today }}</span>
  </div>
  <div class="metric-card" style="background: var(--card-bg, #fff); border: 1px solid var(--border); border-radius: 8px; padding: 16px;">
    <span class="metric-label" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text3, #6c757d);">Warnings Today</span>
    <span class="metric-value" style="font-size: 24px; font-weight: 700; display: block; margin-top: 4px; color:{% if total_warnings > 0 %}#ffc107{% else %}#28a745{% endif %};">
      {{ total_warnings }}
    </span>
  </div>
  <div class="metric-card" style="background: var(--card-bg, #fff); border: 1px solid var(--border); border-radius: 8px; padding: 16px;">
    <span class="metric-label" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text3, #6c757d);">Critical (All Time)</span>
    <span class="metric-value" style="font-size: 24px; font-weight: 700; display: block; margin-top: 4px; color:{% if total_critical > 0 %}#dc3545{% else %}#28a745{% endif %};">
      {{ total_critical }}
    </span>
  </div>
</div>

<div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:16px;">
  <a href="{% url 'audit:log_list' %}" class="quick-btn {% if not filters.quick %}active{% endif %}">All Logs</a>
  <a href="?quick=today" class="quick-btn {% if filters.quick == 'today' %}active{% endif %}">Today</a>
  <a href="?quick=week"  class="quick-btn {% if filters.quick == 'week'  %}active{% endif %}">Last 7 Days</a>
  <a href="?quick=month" class="quick-btn {% if filters.quick == 'month' %}active{% endif %}">Last 30 Days</a>
  <a href="?quick=critical" class="quick-btn {% if filters.quick == 'critical' %}active{% endif %}" style="border-color: #f5c6cb; color:#dc3545;">Critical Only</a>
</div>

<div class="card" style="background: var(--card-bg, #fff); border: 1px solid var(--border); border-radius: 8px; margin-bottom: 24px;">
  <div class="card-body" style="padding: 20px;">
    <form method="get">
      <div class="filter-grid">
        <div style="grid-column: span min(2, auto);">
          <input type="text" name="q" value="{{ filters.q }}" class="form-control" placeholder="Search action or description…" style="width: 100%;">
        </div>
        <div>
          <input type="text" name="user" value="{{ filters.user }}" class="form-control" placeholder="By username…" style="width: 100%;">
        </div>
        <div>
          <select name="category" class="form-control" style="width: 100%;">
            <option value="">All Categories</option>
            {% for val, label in categories %}
            <option value="{{ val }}" {% if filters.category == val %}selected{% endif %}>{{ label }}</option>
            {% endfor %}
          </select>
        </div>
        <div>
          <select name="level" class="form-control" style="width: 100%;">
            <option value="">All Levels</option>
            {% for val, label in levels %}
            <option value="{{ val }}" {% if filters.level == val %}selected{% endif %}>{{ label }}</option>
            {% endfor %}
          </select>
        </div>
        <div>
          <input type="date" name="date_from" value="{{ filters.date_from }}" class="form-control" style="width: 100%;">
        </div>
        <div>
          <input type="date" name="date_to" value="{{ filters.date_to }}" class="form-control" style="width: 100%;">
        </div>
        <div style="display: flex; gap: 6px;">
          <button type="submit" class="btn btn-primary" style="flex: 1;">Filter</button>
          <a href="{% url 'audit:log_list' %}" class="btn btn-outline" style="padding: 8px 12px;" title="Reset Filters">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></svg>
          </a>
        </div>
      </div>
    </form>
  </div>
</div>

<div class="card" style="background: var(--card-bg, #fff); border: 1px solid var(--border); border-radius: 8px; overflow: hidden;">
  <div class="card-head" style="padding: 16px 20px; border-bottom: 1px solid var(--border); background: var(--card-header-bg, #fafafa);">
    <h3 style="margin: 0; font-size: 15px; font-weight: 600; color: var(--text);">
      Log Entries
      <span style="font-size: 12px; color: var(--text3, #6c757d); font-weight: normal; margin-left: 6px;">
        ({{ page_obj.paginator.count }} total records)
      </span>
    </h3>
  </div>
  <div class="card-body" style="padding: 0; overflow-x: auto;">
    {% if page_obj.object_list %}
    <table class="audit-table" style="width: 100%; border-collapse: collapse; font-size: 13px; min-width: 850px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="width: 90px;">Time</th>
          <th style="width: 110px;">Level</th>
          <th style="width: 120px;">Category</th>
          <th style="width: 140px;">User Context</th>
          <th>Action Executed</th>
          <th>Target Object</th>
          <th style="width: 120px;">IP Address</th>
          <th style="width: 50px;"></th>
        </tr>
      </thead>
      <tbody>
        {% for log in page_obj %}
        <tr>
          <td style="color: var(--text3); white-space: nowrap; line-height: 1.3;">
            <strong style="color: var(--text2);">{{ log.timestamp|date:"d M" }}</strong><br>
            <span style="font-size: 11px; opacity: 0.8;">{{ log.timestamp|date:"H:i:s" }}</span>
          </td>
          <td>
            <span class="level-badge level-{{ log.level }}">{{ log.get_level_display }}</span>
          </td>
          <td style="color: var(--text2); font-weight: 500;">{{ log.get_category_display }}</td>
          <td>
            <div style="font-weight: 600; color: var(--text);">{{ log.username|default:"System" }}</div>
            <div style="font-size: 11px; color: var(--text3);">{{ log.user_role|default:"Manager Action" }}</div>
          </td>
          <td>
            <div style="font-weight: 500; color: var(--text);">{{ log.action }}</div>
            {% if log.description %}
            <div style="font-size: 11px; color: var(--text3); margin-top: 3px; line-height: 1.4; max-width: 320px;">
              {{ log.description|truncatechars:100 }}
            </div>
            {% endif %}
          </td>
          <td>
            {% if log.object_type %}
            <div style="font-size: 12px; font-weight: 500; color: var(--text2);">{{ log.object_type }} <span style="color: var(--text3);">#{{ log.object_id }}</span></div>
            <div style="font-size: 11px; color: var(--text3); margin-top: 2px;">{{ log.object_repr|truncatechars:45 }}</div>
            {% else %}
            <span style="color: var(--text3); opacity: 0.6;">—</span>
            {% endif %}
          </td>
          <td style="font-family: monospace; font-size: 12px; color: var(--text3);">{{ log.ip_address|default:"—" }}</td>
          <td style="text-align: right; font-weight: 600;">
            <a href="{% url 'audit:log_detail' log.pk %}" style="color: #4a6cf7; text-decoration: none; display: inline-flex; align-items: center; gap: 2px;">
              Details →
            </a>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    {% if page_obj.has_other_pages %}
    <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; border-top: 1px solid var(--border); background: var(--card-header-bg, #fafafa);">
      <span style="font-size: 12px; color: var(--text3);">
        Showing Page <strong>{{ page_obj.number }}</strong> of {{ page_obj.paginator.num_pages }}
      </span>
      <div style="display: flex; gap: 6px;">
        {% if page_obj.has_previous %}
        <a href="?page={{ page_obj.previous_page_number }}&{{ request.GET.urlencode }}" class="btn btn-outline btn-sm">← Previous</a>
        {% endif %}
        {% if page_obj.has_next %}
        <a href="?page={{ page_obj.next_page_number }}&{{ request.GET.urlencode }}" class="btn btn-outline btn-sm">Next Page →</a>
        {% endif %}
      </div>
    </div>
    {% endif %}

    {% else %}
    <div style="padding: 48px; text-align: center; color: var(--text3);">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 8px; opacity: 0.5;"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
      <p style="margin: 0; font-size: 14px;">No matching system log entries found for the selected filter parameters.</p>
    </div>
    {% endif %}
  </div>
</div>
{% endblock %}